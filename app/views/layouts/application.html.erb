<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "AdoteBrasil - Adoção de Pets" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="Conectamos animais que precisam de um lar com famílias amorosas em todo o Brasil.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Google Fonts - Inter %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <style>
      body { font-family: 'Inter', system-ui, sans-serif; }
    </style>
  </head>

  <body class="min-h-screen bg-gray-50 antialiased">
    <%= render "shared/header" %>
    
    <main>
      <% if notice %>
        <div class="fixed top-20 right-4 z-50 animate-fade-up">
          <div class="rounded-xl bg-green-500 px-6 py-3 text-white shadow-elevated">
            <%= notice %>
          </div>
        </div>
      <% end %>
      
      <% if alert %>
        <div class="fixed top-20 right-4 z-50 animate-fade-up">
          <div class="rounded-xl bg-red-500 px-6 py-3 text-white shadow-elevated">
            <%= alert %>
          </div>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
