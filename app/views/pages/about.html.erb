<!-- Hero -->
<section class="bg-gradient-hero py-16 md:py-24">
  <div class="container mx-auto px-4 text-center">
    <div class="mx-auto max-w-3xl">
      <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-warm shadow-glow">
        <svg class="h-8 w-8 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </div>
      <h1 class="mb-6 text-4xl font-bold text-gray-900 md:text-5xl">
        Sobre o <span class="text-gradient-warm">AdoteBrasil</span>
      </h1>
      <p class="text-lg text-gray-500">
        Somos uma plataforma que conecta animais que precisam de um lar 
        com famílias amorosas em todo o Brasil. Nossa missão é facilitar 
        a descoberta e tornar a adoção responsável mais acessível.
      </p>
    </div>
  </div>
</section>

<!-- Mission -->
<section class="py-16 md:py-24">
  <div class="container mx-auto px-4">
    <div class="grid gap-8 md:grid-cols-3">
      <div class="rounded-2xl bg-white p-8 shadow-soft">
        <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-orange-100 text-orange-500">
          <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </div>
        <h3 class="mb-3 text-xl font-bold text-gray-900">Nossa Missão</h3>
        <p class="text-gray-500">
          Reduzir o número de animais abandonados conectando-os com 
          famílias amorosas de forma rápida e direta.
        </p>
      </div>

      <div class="rounded-2xl bg-white p-8 shadow-soft">
        <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-green-100 text-green-500">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <h3 class="mb-3 text-xl font-bold text-gray-900">Conexão Direta</h3>
        <p class="text-gray-500">
          Facilitamos o encontro entre cuidadores e adotantes, 
          sem intermediar o processo de adoção.
        </p>
      </div>

      <div class="rounded-2xl bg-white p-8 shadow-soft">
        <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-orange-100 text-orange-500">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <h3 class="mb-3 text-xl font-bold text-gray-900">Responsabilidade</h3>
        <p class="text-gray-500">
          Incentivamos a adoção responsável, onde ambas as partes 
          verificam e cuidam do bem-estar animal.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- How It Works Detail -->
<section class="bg-gray-100/50 py-16 md:py-24">
  <div class="container mx-auto px-4">
    <h2 class="mb-12 text-center text-3xl font-bold text-gray-900 md:text-4xl">
      Como Funciona
    </h2>

    <div class="mx-auto max-w-3xl space-y-8">
      <div class="flex gap-6">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-warm text-lg font-bold text-white">
          1
        </div>
        <div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">
            Anuncie seu animal para adoção
          </h3>
          <p class="text-gray-500">
            Preencha as informações do animal e adicione pelo menos um link de contato 
            público (WhatsApp, Instagram ou Facebook). Esses links serão 
            exibidos nos seus anúncios.
          </p>
        </div>
      </div>

      <div class="flex gap-6">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-warm text-lg font-bold text-white">
          2
        </div>
        <div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">
            Aguarde contato dos interessados
          </h3>
          <p class="text-gray-500">
            Pessoas interessadas entrarão em contato através dos seus links públicos.
            Converse, tire dúvidas e combine uma visita ao animal.
          </p>
        </div>
      </div>

      <div class="flex gap-6">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-warm text-lg font-bold text-white">
          3
        </div>
        <div>
          <h3 class="mb-2 text-lg font-bold text-gray-900">
            Finalize a adoção com responsabilidade
          </h3>
          <p class="text-gray-500">
            Verifique se a pessoa tem condições de cuidar do animal.
            Recomendamos sempre fazer uma visita prévia e assinar um termo de adoção.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-16 md:py-24">
  <div class="container mx-auto px-4 text-center">
    <h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
      Pronto para começar?
    </h2>
    <p class="mx-auto mb-8 max-w-xl text-gray-500">
      Encontre seu novo companheiro ou ajude um animal a encontrar um lar amoroso.
    </p>
    <div class="flex flex-col justify-center gap-4 sm:flex-row">
      <%= link_to animals_path, class: "btn-hero" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        Ver Animais
      <% end %>
      <%= link_to new_animal_path, class: "inline-flex items-center justify-center gap-2 rounded-xl border-2 border-gray-200 bg-white px-6 py-3 font-semibold text-gray-700 transition-all hover:border-gray-300 hover:bg-gray-50" do %>
        Anunciar para Adoção
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      <% end %>
    </div>
  </div>
</section>
