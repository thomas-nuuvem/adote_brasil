<!-- Hero Section -->
<section class="relative overflow-hidden bg-gradient-hero">
  <div class="container mx-auto px-4 py-16 md:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <!-- Text Content -->
      <div class="animate-fade-up text-center lg:text-left">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-orange-100 px-4 py-2 text-sm font-medium text-orange-600">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <% if @total_animals > 0 %>
            <%= @total_animals %> animais esperando um lar
          <% else %>
            Plataforma de adoção de pets
          <% end %>
        </div>
        <h1 class="mb-6 text-4xl font-bold leading-tight text-gray-900 md:text-5xl lg:text-6xl">
          Encontre seu novo
          <span class="text-gradient-warm">melhor amigo</span>
        </h1>
        <p class="mx-auto mb-8 max-w-lg text-lg text-gray-500 lg:mx-0">
          Conectamos animais que precisam de um lar com famílias amorosas 
          em todo o Brasil. Sua nova história de amor começa aqui.
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row lg:justify-start">
          <%= link_to animals_path, class: "btn-hero" do %>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            Ver Animais
          <% end %>
          <%= link_to new_animal_path, class: "inline-flex items-center justify-center gap-2 rounded-xl border-2 border-gray-200 bg-white px-6 py-3 font-semibold text-gray-700 transition-all hover:border-gray-300 hover:bg-gray-50" do %>
            Anunciar para Adoção
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          <% end %>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="relative hidden lg:block">
        <div class="animate-float relative">
          <div class="absolute -inset-4 rounded-3xl bg-gradient-warm opacity-20 blur-2xl"></div>
          <div class="relative rounded-3xl shadow-elevated overflow-hidden aspect-[4/3] bg-gradient-to-br from-orange-100 to-orange-200 flex items-center justify-center">
            <div class="text-center">
              <span class="text-8xl block mb-4">🐕</span>
              <span class="text-6xl">🐱</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Wave -->
  <div class="absolute -bottom-1 left-0 right-0">
    <svg viewBox="0 0 1440 120" class="w-full fill-gray-50">
      <path d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"/>
    </svg>
  </div>
</section>

<!-- How It Works -->
<section class="py-16 md:py-24 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="mb-12 text-center">
      <h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
        Como Funciona
      </h2>
      <p class="mx-auto max-w-2xl text-gray-500">
        Facilitamos o encontro entre pets e famílias, de forma simples e direta.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-3">
      <!-- Step 1 -->
      <div class="group rounded-2xl bg-white p-8 shadow-soft transition-all duration-300 hover:shadow-card">
        <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-orange-100 text-orange-500">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <h3 class="mb-3 text-xl font-bold text-gray-900">Encontre</h3>
        <p class="text-gray-500">Navegue pelos animais disponíveis e encontre o companheiro ideal para você.</p>
      </div>

      <!-- Step 2 -->
      <div class="group rounded-2xl bg-white p-8 shadow-soft transition-all duration-300 hover:shadow-card">
        <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-green-100 text-green-500">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <h3 class="mb-3 text-xl font-bold text-gray-900">Conecte</h3>
        <p class="text-gray-500">Entre em contato diretamente com o cuidador através das redes sociais.</p>
      </div>

      <!-- Step 3 -->
      <div class="group rounded-2xl bg-white p-8 shadow-soft transition-all duration-300 hover:shadow-card">
        <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-orange-100 text-orange-500">
          <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </div>
        <h3 class="mb-3 text-xl font-bold text-gray-900">Adote</h3>
        <p class="text-gray-500">Combine a adoção diretamente com o responsável e dê um lar ao seu novo amigo.</p>
      </div>
    </div>
  </div>
</section>

<!-- Featured Animals -->
<section class="bg-gray-100/50 py-16 md:py-24">
  <div class="container mx-auto px-4">
    <div class="mb-12 flex flex-col items-center justify-between gap-4 md:flex-row">
      <div>
        <h2 class="mb-2 text-3xl font-bold text-gray-900 md:text-4xl">
          Animais em Destaque
        </h2>
        <p class="text-gray-500">
          Conheça alguns dos pets que estão esperando por um lar amoroso.
        </p>
      </div>
      <%= link_to animals_path, class: "inline-flex items-center gap-2 rounded-xl border-2 border-gray-200 bg-white px-4 py-2 font-medium text-gray-700 transition-all hover:border-gray-300" do %>
        Ver Todos
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      <% end %>
    </div>

    <% if @featured_animals.any? %>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% @featured_animals.each do |animal| %>
          <%= render "animals/animal_card", animal: animal %>
        <% end %>
      </div>
    <% else %>
      <div class="flex flex-col items-center justify-center rounded-2xl bg-white py-16">
        <div class="mb-4 text-6xl">🐾</div>
        <h3 class="mb-2 text-xl font-semibold text-gray-900">
          Nenhum animal cadastrado ainda
        </h3>
        <p class="mb-6 text-gray-500">
          Seja o primeiro a anunciar um pet para adoção!
        </p>
        <%= link_to "Anunciar Animal", new_animal_path, class: "btn-hero" %>
      </div>
    <% end %>
  </div>
</section>

<!-- Trust Banner -->
<section class="py-16 md:py-24">
  <div class="container mx-auto px-4">
    <div class="rounded-3xl bg-gradient-warm p-8 md:p-12 text-center text-white">
      <div class="mx-auto max-w-2xl">
        <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-white/20">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <h2 class="mb-4 text-3xl font-bold md:text-4xl">
          Adoção Responsável
        </h2>
        <p class="mb-8 text-lg opacity-90">
          A plataforma conecta você diretamente com os cuidadores. 
          Recomendamos sempre conhecer o animal pessoalmente antes de adotar.
        </p>
        <%= link_to about_path, class: "inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 font-semibold text-orange-500 transition-all hover:bg-gray-100" do %>
          Saiba Mais
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        <% end %>
      </div>
    </div>
  </div>
</section>
