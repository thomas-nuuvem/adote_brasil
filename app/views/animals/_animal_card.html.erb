<%= link_to animal_path(animal), class: "group block overflow-hidden rounded-2xl bg-white shadow-soft transition-all duration-300 hover:shadow-elevated hover:-translate-y-1", data: { turbo_frame: "_top" } do %>
  <!-- Image Container -->
  <div class="relative aspect-[4/3] overflow-hidden">
    <% if animal.image.present? %>
      <img src="<%= animal.image %>" alt="<%= animal.name %>" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105">
    <% else %>
      <div class="h-full w-full bg-gradient-to-br from-orange-100 to-orange-200 flex items-center justify-center">
        <span class="text-6xl"><%= animal.species_emoji %></span>
      </div>
    <% end %>
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-transparent"></div>
    
    <!-- Species Badge -->
    <div class="absolute left-3 top-3">
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-lg shadow-soft backdrop-blur-sm">
        <%= animal.species_emoji %>
      </span>
    </div>

    <!-- Favorite Button -->
    <button class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-gray-500 shadow-soft backdrop-blur-sm transition-colors hover:text-orange-500" onclick="event.preventDefault(); event.stopPropagation();">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
      </svg>
    </button>

    <!-- Name on Image -->
    <div class="absolute bottom-3 left-3 right-3">
      <h3 class="text-xl font-bold text-white drop-shadow-md">
        <%= animal.name %>
      </h3>
    </div>
  </div>

  <!-- Content -->
  <div class="p-4">
    <!-- Location -->
    <div class="mb-3 flex items-center gap-1.5 text-sm text-gray-500">
      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <span><%= animal.location %></span>
    </div>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5">
      <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">
        <%= animal.gender_label %>
      </span>
      <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">
        <%= animal.age %>
      </span>
      <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600">
        <%= animal.size_label %>
      </span>
    </div>
  </div>
<% end %>
