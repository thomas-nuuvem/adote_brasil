<div class="container mx-auto max-w-2xl px-4 py-8">
  <h1 class="mb-2 text-3xl font-bold text-gray-900">
    Anunciar Animal
  </h1>
  <p class="mb-8 text-gray-500">
    Preencha as informações do animal que deseja colocar para adoção
  </p>

  <%= form_with model: @animal, local: true, class: "space-y-6" do |f| %>
    <% if @animal.errors.any? %>
      <div class="rounded-xl bg-red-50 border border-red-200 p-4">
        <h2 class="text-red-800 font-medium mb-2"><%= pluralize(@animal.errors.count, "erro") %> encontrado(s):</h2>
        <ul class="list-disc list-inside text-red-700 text-sm">
          <% @animal.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Photo Upload -->
    <div class="rounded-2xl bg-white p-6 shadow-soft">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">Foto do Animal</h2>
      <p class="text-sm text-gray-500 mb-4">Cole a URL de uma foto do animal</p>
      <%= f.text_field :image, placeholder: "https://exemplo.com/foto-do-pet.jpg", class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20" %>
    </div>

    <!-- Basic Info -->
    <div class="rounded-2xl bg-white p-6 shadow-soft">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Informações Básicas</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :name, "Nome do animal *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, placeholder: "Ex: Luna", class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20" %>
        </div>

        <div>
          <%= f.label :species, "Espécie *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :species, options_for_select([["Selecione", ""], ["🐕 Cachorro", "dog"], ["🐱 Gato", "cat"], ["🐾 Outro", "other"]], @animal.species), {}, class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :breed, "Raça (opcional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :breed, placeholder: "Ex: Vira-lata, Labrador...", class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20" %>
        </div>

        <div>
          <%= f.label :age, "Idade *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :age, placeholder: "Ex: 2 anos, 6 meses...", class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20" %>
        </div>

        <div>
          <%= f.label :gender, "Sexo *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :gender, options_for_select([["Selecione", ""], ["Macho", "male"], ["Fêmea", "female"]], @animal.gender), {}, class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :size, "Porte *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :size, options_for_select([["Selecione", ""], ["Pequeno", "small"], ["Médio", "medium"], ["Grande", "large"]], @animal.size), {}, class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none" %>
        </div>
      </div>
    </div>

    <!-- Location -->
    <div class="rounded-2xl bg-white p-6 shadow-soft">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Localização</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :city, "Cidade *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :city, placeholder: "Ex: São Paulo", class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20" %>
        </div>

        <div>
          <%= f.label :state, "Estado *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :state, options_for_select([["Selecione", ""]] + Animal::STATES.map { |s| [s, s] }, @animal.state), {}, class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none" %>
        </div>
      </div>
    </div>

    <!-- Description -->
    <div class="rounded-2xl bg-white p-6 shadow-soft">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Descrição</h2>
      <%= f.label :description, "Conte sobre o animal *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 4, placeholder: "Descreva a personalidade, comportamento e outras informações importantes...", class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20" %>
    </div>

    <!-- Health -->
    <div class="rounded-2xl bg-white p-6 shadow-soft">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Saúde</h2>
      <div class="space-y-3">
        <label class="flex items-center gap-3 cursor-pointer">
          <%= f.check_box :is_vaccinated, class: "h-5 w-5 rounded border-gray-300 text-orange-500 focus:ring-orange-500" %>
          <span class="text-gray-700">Animal vacinado</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <%= f.check_box :is_neutered, class: "h-5 w-5 rounded border-gray-300 text-orange-500 focus:ring-orange-500" %>
          <span class="text-gray-700">Animal castrado</span>
        </label>
      </div>
    </div>

    <!-- Caregiver Info -->
    <div class="rounded-2xl bg-white p-6 shadow-soft">
      <h2 class="text-lg font-semibold text-gray-900 mb-1">Informações de Contato</h2>
      <p class="text-sm text-gray-500 mb-4">Adicione pelo menos uma forma de contato</p>
      <div class="space-y-4">
        <div>
          <%= f.label :caregiver_name, "Seu nome *", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :caregiver_name, placeholder: "Ex: Maria Santos", class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20" %>
        </div>

        <div>
          <%= f.label :caregiver_whatsapp, "WhatsApp", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :caregiver_whatsapp, placeholder: "Ex: +5511999999999", class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20" %>
        </div>

        <div>
          <%= f.label :caregiver_instagram, "Instagram", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :caregiver_instagram, placeholder: "Ex: @seu_usuario", class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20" %>
        </div>

        <div>
          <%= f.label :caregiver_facebook, "Facebook", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :caregiver_facebook, placeholder: "Ex: seu.usuario", class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20" %>
        </div>
      </div>
    </div>

    <!-- Submit -->
    <div class="flex justify-end gap-4">
      <%= link_to "Cancelar", animals_path, class: "inline-flex items-center justify-center rounded-xl border-2 border-gray-200 bg-white px-6 py-3 font-semibold text-gray-700 transition-all hover:border-gray-300 hover:bg-gray-50" %>
      <%= f.submit "Anunciar Animal", class: "btn-hero cursor-pointer" %>
    </div>
  <% end %>
</div>
