<footer class="border-t border-gray-200 bg-gray-100/50">
  <div class="container mx-auto px-4 py-12">
    <div class="grid gap-8 md:grid-cols-4">
      <!-- Brand -->
      <div class="md:col-span-2">
        <%= link_to root_path, class: "mb-4 flex items-center gap-2" do %>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-warm shadow-soft">
            <svg class="h-5 w-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>
          <span class="text-xl font-bold text-gray-900">
            Adote<span class="text-gradient-warm">Brasil</span>
          </span>
        <% end %>
        <p class="max-w-sm text-sm text-gray-500">
          Conectando animais que precisam de um lar com famílias amorosas em todo o Brasil. 
          Juntos, podemos fazer a diferença na vida de milhares de pets.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h4 class="mb-4 font-semibold text-gray-900">Navegação</h4>
        <ul class="space-y-2 text-sm text-gray-500">
          <li>
            <%= link_to "Início", root_path, class: "transition-colors hover:text-orange-500" %>
          </li>
          <li>
            <%= link_to "Ver Animais", animals_path, class: "transition-colors hover:text-orange-500" %>
          </li>
          <li>
            <%= link_to "Anunciar", new_animal_path, class: "transition-colors hover:text-orange-500" %>
          </li>
          <li>
            <%= link_to "Sobre Nós", about_path, class: "transition-colors hover:text-orange-500" %>
          </li>
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h4 class="mb-4 font-semibold text-gray-900">Informações</h4>
        <ul class="space-y-2 text-sm text-gray-500">
          <li>
            <%= link_to "Como Funciona", about_path, class: "transition-colors hover:text-orange-500" %>
          </li>
          <li>
            <span class="cursor-not-allowed">Termos de Uso</span>
          </li>
          <li>
            <span class="cursor-not-allowed">Privacidade</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-gray-200 pt-8 md:flex-row">
      <p class="text-sm text-gray-500">
        © <%= Date.current.year %> AdoteBrasil. Feito com 💚 para os animais.
      </p>
      <p class="text-xs text-gray-500">
        Plataforma de descoberta. Não intermediamos adoções.
      </p>
    </div>
  </div>
</footer>
