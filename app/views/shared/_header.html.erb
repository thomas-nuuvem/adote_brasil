<header class="sticky top-0 z-50 w-full border-b border-gray-200/50 bg-white/80 backdrop-blur-md" data-controller="mobile-menu">
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <!-- Logo -->
    <%= link_to root_path, class: "flex items-center gap-2 transition-opacity hover:opacity-80" do %>
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-warm shadow-soft">
        <svg class="h-5 w-5 text-white" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </div>
      <span class="text-xl font-bold text-gray-900">
        Adote<span class="text-gradient-warm">Brasil</span>
      </span>
    <% end %>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-8 md:flex">
      <%= link_to "Início", root_path, class: "text-sm font-medium transition-colors hover:text-orange-500 #{current_page?(root_path) ? 'text-orange-500' : 'text-gray-500'}" %>
      <%= link_to "Animais", animals_path, class: "text-sm font-medium transition-colors hover:text-orange-500 #{current_page?(animals_path) ? 'text-orange-500' : 'text-gray-500'}" %>
      <%= link_to "Sobre", about_path, class: "text-sm font-medium transition-colors hover:text-orange-500 #{current_page?(about_path) ? 'text-orange-500' : 'text-gray-500'}" %>
    </nav>

    <!-- Desktop Actions -->
    <div class="hidden items-center gap-3 md:flex">
      <%= link_to new_animal_path, class: "btn-hero text-sm" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
        </svg>
        Anunciar
      <% end %>
    </div>

    <!-- Mobile Menu Button -->
    <button class="flex h-10 w-10 items-center justify-center rounded-lg text-gray-900 transition-colors hover:bg-gray-100 md:hidden"
            data-action="click->mobile-menu#toggle"
            aria-label="Toggle menu">
      <svg class="h-5 w-5" data-mobile-menu-target="openIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg class="h-5 w-5 hidden" data-mobile-menu-target="closeIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="hidden absolute left-0 top-16 w-full border-b border-gray-200 bg-white p-4 shadow-card md:hidden" data-mobile-menu-target="menu">
    <nav class="flex flex-col gap-2">
      <%= link_to "Início", root_path, class: "rounded-lg px-4 py-3 text-sm font-medium transition-colors hover:bg-gray-100 #{current_page?(root_path) ? 'bg-gray-100 text-orange-500' : 'text-gray-900'}" %>
      <%= link_to "Animais", animals_path, class: "rounded-lg px-4 py-3 text-sm font-medium transition-colors hover:bg-gray-100 #{current_page?(animals_path) ? 'bg-gray-100 text-orange-500' : 'text-gray-900'}" %>
      <%= link_to "Sobre", about_path, class: "rounded-lg px-4 py-3 text-sm font-medium transition-colors hover:bg-gray-100 #{current_page?(about_path) ? 'bg-gray-100 text-orange-500' : 'text-gray-900'}" %>
      
      <div class="mt-2 flex flex-col gap-2 border-t border-gray-200 pt-4">
        <%= link_to new_animal_path, class: "btn-hero justify-center" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
          Anunciar Animal
        <% end %>
      </div>
    </nav>
  </div>
</header>
